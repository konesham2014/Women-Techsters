<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Digital Credit Experience — Mini Project</title>

  <!-- Use Inter from Google Fonts to match the screenshot -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

  <!-- External stylesheet -->
  <link rel="stylesheet" href="index.css">
</head>
<body>
  <div class="frame" role="application" aria-label="Mortgage calculator">
    <div class="nav">
      <div class="brand">AG BANK</div>
      <div class="hamburger" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>

    <div class="content">
      <div class="left">
        <h1>Get started with Digital Credit Experience</h1>
        <p class="lead">Qualify or apply your mortgage in minutes</p>

        <!-- Purchase price -->
        <div class="field">
          <div class="label">Purchase price</div>
          <div class="money-row" aria-hidden="true">
            <div class="currency">$</div>
            <div id="purchaseDisplay" style="font-size:22px">250,000</div>
          </div>
          <div class="slider-wrap">
            <input id="purchaseRange" type="range" min="50000" max="12500000" step="1000" value="250000" aria-label="Purchase price" />
            <div class="slider-markers" aria-hidden="true">
              <div>$50 000</div>
              <div>$12.5 million</div>
            </div>
          </div>
        </div>

        <!-- Down payment -->
        <div class="field">
          <div class="label">Down payment</div>
          <div class="money-row" aria-hidden="true">
            <div class="currency">$</div>
            <div id="downDisplay" style="font-size:22px">50,000</div>
          </div>
          <div class="slider-wrap">
            <input id="downRange" type="range" min="0" max="6250000" step="1000" value="50000" aria-label="Down payment" />
            <div class="note">4% or more of purchase price</div>
          </div>
        </div>

        <div class="field row" style="margin-top:16px">
          <div class="period">
            <div class="label">Period</div>
            <label class="radio-item"><input type="radio" name="period" value="5/1" /> 5/1 ARM variable</label>
            <label class="radio-item"><input type="radio" name="period" value="15" /> 15 year fixed</label>
            <label class="radio-item"><input type="radio" name="period" value="30" checked/> 30 year fixed</label>
          </div>
          <div class="zip">
            <div class="label">Zip code</div>
            <input id="zip" type="text" maxlength="10" value="90459" style="border:none;background:transparent;font-weight:700;font-size:14px;color:#243b46" aria-label="Zip code" />
          </div>
        </div>
      </div>

      <div class="right">
        <div class="card" aria-live="polite">
          <div class="subtitle">Your total payment will be</div>
          <div style="text-align:center">
            <span class="small-dollar">$</span>
            <span class="big-amount" id="monthlyDisplay">780</span>
          </div>
          <div class="stats" style="margin-top:18px">
            <div class="stat">
              <div class="label">Rate</div>
              <div class="val" id="rateDisplay">5.250%</div>
            </div>
            <div class="stat">
              <div class="label">APR</div>
              <div class="val" id="aprDisplay">4.418%</div>
            </div>
            <div class="stat">
              <div class="label">Points</div>
              <div class="val" id="pointsDisplay">0.325</div>
            </div>
          </div>

          <a href="#" class="cta" id="cta">Get started</a>
        </div>
      </div>
    </div>
  </div>

  <!-- External script -->
  <script src="index.js"></script>
</body>
</html>







/* Reset + base */
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  background: linear-gradient(135deg,#cfe7ff 0%, #c8b6ff 50%, #b08bff 100%);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:48px;
}

/* Main frame */
.frame{
  width:90%;
  max-width:1200px;
  background: #e9f0f8;
  border-radius:2px;
  box-shadow: 0 40px 60px rgba(11,42,80,0.08), inset 0 -20px 30px rgba(0,60,120,0.03);
  padding:28px 36px 60px;
  position:relative;
}

/* top nav bar */
.nav{
  height:56px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 6px;
  margin-bottom:10px;
}
.brand{
  color:#1e78ff;
  font-weight:700;
  letter-spacing:1px;
}
.hamburger{
  width:28px;height:20px;display:flex;flex-direction:column;justify-content:space-between;
}
.hamburger span{height:2px;background:#6da6ff;border-radius:2px}

/* content area layout */
.content{
  display:flex;
  gap:28px;
  align-items:flex-start;
}

/* left column */
.left{
  flex:1.1;
  padding:28px 36px 24px;
}
h1{
  margin:10px 0 6px;
  font-size:26px;
  color:#2f4858;
  font-weight:700;
}
p.lead{
  margin:0 0 28px;
  color:#9db0bd;
  font-size:14px;
}

.field{
  margin-bottom:26px;
}
.label{
  color:#98a9b3;
  font-size:13px;
  margin-bottom:8px;
}

.money-row{
  display:flex;
  align-items:baseline;
  gap:12px;
  font-weight:700;
  color:#243b46;
}
.money-row .currency{font-weight:600;color:#607d90;}

/* slider container */
.slider-wrap{padding:8px 0 0}
input[type=range]{
  -webkit-appearance:none;
  width:100%;
  height:6px;
  border-radius:6px;
  background:linear-gradient(90deg,#2f8fff 0%, #2f8fff 40%, #cbd7df 40%);
  outline:none;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;
  width:16px;height:16px;border-radius:50%;
  background:#fff;border:4px solid #4a90ff;box-shadow:0 3px 6px rgba(66,133,244,0.25);
  margin-top:-6px;
}
/* Firefox thumb */
input[type=range]::-moz-range-thumb{
  width:16px;height:16px;border-radius:50%;
  background:#fff;border:4px solid #4a90ff;box-shadow:0 3px 6px rgba(66,133,244,0.25);
}
/* IE/Edge fallback */
input[type=range]::-ms-thumb{
  width:16px;height:16px;border-radius:50%;
  background:#fff;border:4px solid #4a90ff;
}

.slider-markers{display:flex;justify-content:space-between;color:#b1c2ca;font-size:12px;margin-top:8px}

.note{color:#a8bac2;font-size:12px;margin-top:8px}

/* period + zip */
.row{
  display:flex;
  gap:28px;
  align-items:flex-start;
}
.period{
  flex:1;
}
.zip{
  width:120px;
  color:#243b46;
  font-weight:600;
}
.radio-item{display:flex;gap:8px;align-items:center;margin-bottom:8px;color:#34525b}
.radio-item input{accent-color:#2f8fff}

/* right card */
.right{
  flex:0 0 380px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.card{
  width:100%;
  background:#fff;
  border-radius:14px;
  padding:26px 30px;
  box-shadow: 0 20px 30px rgba(41,62,83,0.08);
  text-align: center;
  top: 12px;
  position:relative;
}
.card .subtitle{color:#9fb0b9;font-size:13px;text-align:center;margin-bottom:8px}
.big-amount{
  font-size:72px;
  font-weight:800;
  color:#1a64ff;
  text-align:center;
  line-height:1;
}
.small-dollar{font-size:20px;color:#1a64ff;vertical-align:top;margin-right:6px}
.stats{
  display:flex;
  justify-content:space-around;
  margin-top:20px;
  color:#7e9aa3;
  font-size:13px;
}
.stat .label{font-size:12px;color:#b7c7cc;margin-bottom:6px}
.stat .val{font-weight:700;color:#445a62}

.cta{
  display:block;
  width:120px;
  margin:-18px auto 0;
  text-align:center;
  background:linear-gradient(90deg,#9b59ff,#6b49ff);
  color:white;
  padding:10px 12px;
  border-radius:14px;
  box-shadow:0 8px 16px rgba(107,73,255,0.28);
  text-decoration:none;
  font-weight:700;
}

/* small responsive */
@media (max-width:980px){
  .content{flex-direction:column}
  .right{order:2}
  .left{order:1}
  .card{width:100%}
}










/* -----------------------------
   script.js
   Beginner-friendly, well-commented JS controlling sliders + displays.
   ----------------------------- */

/* Utility: format numbers with commas (safe for non-number inputs) */
function fmt(n, decimals = 0) {
  if (typeof n !== 'number') n = Number(n) || 0;
  return n.toLocaleString(undefined, { maximumFractionDigits: decimals, minimumFractionDigits: decimals });
}

/* Grab elements (we expect these to exist in the DOM) */
const purchaseRange = document.getElementById('purchaseRange');
const downRange = document.getElementById('downRange');
const purchaseDisplay = document.getElementById('purchaseDisplay');
const downDisplay = document.getElementById('downDisplay');
const monthlyDisplay = document.getElementById('monthlyDisplay');
const rateDisplay = document.getElementById('rateDisplay');
const aprDisplay = document.getElementById('aprDisplay');
const pointsDisplay = document.getElementById('pointsDisplay');
const periodRadios = document.querySelectorAll('input[name="period"]');

/* Interest rates mapped to period (annual % as base starting point) */
const baseRates = {
  "5/1": 4.25,
  "15": 4.00,
  "30": 5.25
};

/* Return selected period from radio inputs */
function getSelectedPeriod(){
  const sel = document.querySelector('input[name="period"]:checked');
  return sel ? sel.value : '30';
}

/* Monthly payment formula for amortizing loan
   P = principal, annualRatePercent (e.g. 5.25), months = term in months */
function monthlyPayment(P, annualRatePercent, months){
  if (months <= 0) return 0;
  const r = annualRatePercent / 100 / 12;
  if (r === 0) return P / months;
  const pow = Math.pow(1 + r, months);
  const m = P * r * pow / (pow - 1);
  return m;
}

/* Compute points (simulated friendly value) */
function computePoints(loan){
  // small formula to generate a points-like number in a reasonable range
  const pts = Math.max(0.05, Math.min(2.5, (loan / 100000) * 0.0325));
  return pts;
}

/* Compute APR approximate (simulate small fees + small uplift) */
function computeAPR(rate, loan){
  // Add a small fixed uplift and a tiny fee percent effect
  const feeEstimatePercent = Math.min(0.6, Math.max(0, (loan * 0.0015) / Math.max(1, loan) * 100));
  return Math.max(0, rate + 0.1 + feeEstimatePercent);
}

/* Keep down payment slider max synchronized with purchase price */
function clampDownRange(){
  const purchase = Number(purchaseRange.value);
  const maxDown = purchase;
  if (Number(downRange.max) !== maxDown) downRange.max = maxDown;
  if (Number(downRange.value) > maxDown) downRange.value = maxDown;
}

/* Visual: update the filled portion of a range input with a gradient */
function setRangeBackground(range){
  try{
    const val = (range.value - range.min) / (range.max - range.min) * 100;
    range.style.background = `linear-gradient(90deg,#2f8fff ${val}%, #cbd7df ${val}%)`;
  }catch(e){}
}

/* Main update function: calculates values and updates DOM */
function updateAll(){
  const purchase = Number(purchaseRange.value);
  const down = Number(downRange.value);
  const loan = Math.max(0, purchase - down);
  const period = getSelectedPeriod();
  const years = period === '5/1' ? 30 : Number(period); // amortize 5/1 as 30-year
  const months = years * 12;

  /* base interest rate for the period */
  let rate = baseRates[period] ?? 5.25;

  /* small rate tweaks based on LTV (loan-to-value) */
  const ltv = purchase > 0 ? loan / purchase : 1;
  if (ltv > 0.9) rate += 0.45;
  else if (ltv < 0.2) rate -= 0.25;

  /* calculate numbers */
  const monthly = monthlyPayment(loan, rate, months);
  const apr = computeAPR(rate, loan);
  const pts = computePoints(loan);

  /* Update visible displays (formatted) */
  purchaseDisplay.textContent = fmt(purchase, 0);
  downDisplay.textContent = fmt(down, 0);
  monthlyDisplay.textContent = fmt(Math.round(monthly), 0);
  rateDisplay.textContent = rate.toFixed(3) + '%';
  aprDisplay.textContent = apr.toFixed(3) + '%';
  pointsDisplay.textContent = pts.toFixed(3);

  /* Keep slider visuals in sync */
  [purchaseRange, downRange].forEach(r => setRangeBackground(r));
}

/* Events: react to user input */
purchaseRange.addEventListener('input', () => {
  clampDownRange();
  updateAll();
});
downRange.addEventListener('input', updateAll);
periodRadios.forEach(r => r.addEventListener('change', updateAll));

/* keyboard accessibility for sliders */
purchaseRange.addEventListener('keydown', (e) => {
  if (e.key === 'PageUp' || e.key === 'ArrowUp') { purchaseRange.stepUp(); updateAll(); setRangeBackground(purchaseRange); }
  if (e.key === 'PageDown' || e.key === 'ArrowDown') { purchaseRange.stepDown(); updateAll(); setRangeBackground(purchaseRange); }
});
downRange.addEventListener('keydown', (e) => {
  if (e.key === 'PageUp' || e.key === 'ArrowUp') { downRange.stepUp(); updateAll(); setRangeBackground(downRange); }
  if (e.key === 'PageDown' || e.key === 'ArrowDown') { downRange.stepDown(); updateAll(); setRangeBackground(downRange); }
});

/* CTA click: small pulse animation + temporary text change (non-blocking) */
document.getElementById('cta').addEventListener('click', function(e){
  e.preventDefault();
  const card = document.querySelector('.card');
  card.animate([
    { transform: 'translateY(0)' },
    { transform: 'translateY(-6px)' },
    { transform: 'translateY(0)' }
  ], { duration:420, easing:'cubic-bezier(.2,.8,.2,1)' });
  const btn = this;
  btn.textContent = 'Starting...';
  setTimeout(()=>{ btn.textContent = 'Get started'; }, 900);
});

/* Initialize on load */
window.addEventListener('load', () => {
  clampDownRange();
  // set initial backgrounds for sliders
  [purchaseRange, downRange].forEach(r => setRangeBackground(r));
  updateAll();
});
